# Agentic AI Web Scraping Platform. Copy to `.env` for local dev.

ENVIRONMENT=dev
APP_NAME=scraping-platform
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Database (async DSN; the Compose service matches these defaults)
DATABASE_URL=postgresql+asyncpg://scraping:scraping@localhost:55432/scraping
DATABASE_ECHO=false

# Request limits (spec 0001 pins)
REQUEST_BODY_MAX_BYTES=1048576
HTTP_CONNECT_TIMEOUT_S=5
HTTP_READ_TIMEOUT_S=25
HTTP_TOTAL_TIMEOUT_S=30

# Admin UI (spec 0008). ADMIN_API_KEY is required at startup; the backend
# refuses to boot without a non blank value of at least 16 characters.
# Generate one for local dev: `openssl rand -hex 32`.
ADMIN_API_KEY=change-me-to-a-random-32-char-hex-string
SERVE_ADMIN_UI=false
ADMIN_UI_DIST_PATH=frontend/dist
