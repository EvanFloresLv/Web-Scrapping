# Configuración de Google Gemini / Vertex AI para Google ADK
# Opción 1: Google AI Studio (API Key)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=REDACTED

# Opción 2: Google Cloud Vertex AI
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
# GOOGLE_CLOUD_LOCATION=us-central1

# Modelo Gemini por defecto para los agentes (soporta multimodal y Google Search Grounding)
MODEL_NAME=gemini-3.8-flash
PRO_MODEL_NAME=gemini-3.8-flash
